            "text": "/* src/styles.css */\n:root {\n  --gc-primary: #1a73e8;\n  --gc-primary-hover: #1557b0;\n  --gc-primary-light: #e8f0fe;\n  --gc-surface: #ffffff;\n  --gc-background: #f8f9fa;\n  --gc-border: #dadce0;\n  --gc-text-main: #3c4043;\n  --gc-text-sub: #5f6368;\n  --gc-text-light: #80868b;\n  --gc-green: #137333;\n  --gc-green-bg: #e6f4ea;\n  --gc-red: #d93025;\n  --gc-red-bg: #fce8e6;\n  --gc-amber: #f9ab00;\n  --gc-amber-bg: #fef7e0;\n  --gc-radius-sm: 4px;\n  --gc-radius-md: 8px;\n  --gc-radius-lg: 12px;\n  --gc-radius-pill: 24px;\n  --gc-font-family:\n    \"Roboto\",\n    \"Outfit\",\n    -apple-system,\n    sans-serif;\n  --gc-shadow-sm: 0 1px 2px 0 rgba(60,64,67,0.3), 0 1px 3px 1px rgba(60,64,67,0.15);\n  --gc-shadow-md: 0 1px 3px 0 rgba(60,64,67,0.3), 0 4px 8px 3px rgba(60,64,67,0.15);\n}\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\nbody {\n  font-family: var(--gc-font-family);\n  background-color: var(--gc-background);\n  color: var(--gc-text-main);\n  line-height: 1.5;\n  -webkit-font-smoothing: antialiased;\n}\n.gc-app-wrapper {\n  display: flex;\n  flex-direction: column;\n  min-height: 100vh;\n}\n.gc-main-body {\n  margin-top: 64px;\n  padding: 1.5rem 2rem;\n  flex: 1;\n  max-width: 1280px;\n  width: 100%;\n  margin-left: auto;\n  margin-right: auto;\n}\n.gc-card {\n  background: var(--gc-surface);\n  border: 1px solid var(--gc-border);\n  border-radius: var(--gc-radius-md);\n  box-shadow: 0 1px 2px 0 rgba(60, 64, 67, 0.1);\n  overflow: hidden;\n  transition: box-shadow 0.2s ease, border-color 0.2s ease;\n}\n.gc-card:hover {\n  box-shadow: var(--gc-shadow-sm);\n}\n.gc-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.5rem;\n  font-family: var(--gc-font-family);\n  font-size: 0.875rem;\n  font-weight: 500;\n  padding: 0.5rem 1.25rem;\n  border-radius: var(--gc-radius-sm);\n  border: 1px solid transparent;\n  cursor: pointer;\n  transition:\n    background-color 0.2s,\n    border-color 0.2s,\n    box-shadow 0.2s;\n  outline: none;\n  text-decoration: none;\n}\n.gc-btn-primary {\n  background-color: var(--gc-primary);\n  color: #ffffff;\n}\n.gc-btn-primary:hover {\n  background-color: var(--gc-primary-hover);\n  box-shadow: 0 1px 3px 0 rgba(60, 64, 67, 0.3);\n}\n.gc-btn-flat {\n  background-color: transparent;\n  color: var(--gc-primary);\n}\n.gc-btn-flat:hover {\n  background-color: var(--gc-primary-light);\n}\n.gc-btn-outline {\n  background-color: transparent;\n  border-color: var(--gc-border);\n  color: var(--gc-text-main);\n}\n.gc-btn-outline:hover {\n  background-color: var(--gc-background);\n  border-color: var(--gc-text-sub);\n}\n.gc-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.35rem;\n  padding: 0.25rem 0.65rem;\n  border-radius: var(--gc-radius-pill);\n  font-size: 0.78rem;\n  font-weight: 500;\n}\n.gc-badge-info {\n  background-color: var(--gc-primary-light);\n  color: var(--gc-primary);\n}\n.gc-badge-success {\n  background-color: var(--gc-green-bg);\n  color: var(--gc-green);\n}\n.gc-badge-danger {\n  background-color: var(--gc-red-bg);\n  color: var(--gc-red);\n}\n.gc-badge-warning {\n  background-color: var(--gc-amber-bg);\n  color: #b06000;\n}\n.gc-modal-backdrop {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: rgba(32, 33, 36, 0.6);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n  padding: 1rem;\n}\n.gc-modal-card {\n  background: #ffffff;\n  border-radius: var(--gc-radius-md);\n  width: 100%;\n  max-width: 520px;\n  box-shadow: var(--gc-shadow-md);\n  overflow: hidden;\n  animation: gcModalPop 0.2s cubic-bezier(0, 0, 0.2, 1);\n}\n@keyframes gcModalPop {\n  from {\n    opacity: 0;\n    transform: scale(0.95);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1);\n  }\n}\n.gc-modal-header {\n  padding: 1.25rem 1.5rem;\n  border-bottom: 1px solid var(--gc-border);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n.gc-modal-header h3 {\n  font-size: 1.25rem;\n  font-weight: 500;\n  color: var(--gc-text-main);\n}\n.gc-close-btn {\n  background: transparent;\n  border: none;\n  font-size: 1.5rem;\n  color: var(--gc-text-sub);\n  cursor: pointer;\n  padding: 0.2rem 0.5rem;\n  border-radius: 50%;\n}\n.gc-close-btn:hover {\n  background-color: var(--gc-background);\n}\n.gc-modal-body {\n  padding: 1.5rem;\n}\n.gc-modal-footer {\n  padding: 1rem 1.5rem;\n  border-top: 1px solid var(--gc-border);\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 0.75rem;\n  background-color: #fafafa;\n}\n.gc-form-field {\n  margin-bottom: 1.25rem;\n}\n.gc-form-field label {\n  display: block;\n  font-size: 0.825rem;\n  font-weight: 500;\n  color: var(--gc-text-sub);\n  margin-bottom: 0.35rem;\n}\n.gc-form-field input[type=text],\n.gc-form-field input[type=email],\n.gc-form-field input[type=password],\n.gc-form-field input[type=datetime-local],\n.gc-form-field input[type=number],\n.gc-form-field select,\n.gc-form-field textarea {\n  width: 100%;\n  padding: 0.75rem 0.9rem;\n  font-family: var(--gc-font-family);\n  font-size: 0.9rem;\n  border: 1px solid var(--gc-border);\n  border-radius: var(--gc-radius-sm);\n  background: #ffffff;\n  color: var(--gc-text-main);\n  transition: border-color 0.2s, box-shadow 0.2s;\n  outline: none;\n}\n.gc-form-field input:focus,\n.gc-form-field select:focus,\n.gc-form-field textarea:focus {\n  border-color: var(--gc-primary);\n  box-shadow: 0 0 0 2px rgba(26, 115, 232, 0.2);\n}\n.gc-toast-container {\n  position: fixed;\n  bottom: 1.5rem;\n  left: 1.5rem;\n  z-index: 2000;\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n}\n.gc-toast {\n  background: #323232;\n  color: #ffffff;\n  padding: 0.75rem 1.25rem;\n  border-radius: var(--gc-radius-sm);\n  font-size: 0.875rem;\n  box-shadow: var(--gc-shadow-md);\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  animation: gcToastIn 0.25s ease-out;\n}\n@keyframes gcToastIn {\n  from {\n    opacity: 0;\n    transform: translateY(10px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n.hidden {\n  display: none !important;\n}\n\n/* angular:styles/global:styles */\n/*# sourceMappingURL=styles.css.map */\n"
