.locked]=\"locked\" [class.completed]=\"sub?.status === 'APPROVED'\">\n              @if (locked) {\n                <i class=\"fa-solid fa-lock\"></i>\n              } @else if (sub?.status === 'APPROVED') {\n                <i class=\"fa-solid fa-check\"></i>\n              } @else {\n                <i class=\"fa-solid fa-file-lines\"></i>\n              }\n            </div>\n\n            <div>\n              <h3 class=\"gc-assignment-title\">{{ m.title }}</h3>\n              <small class=\"gc-assignment-due\">Due {{ m.deadline | date:'short' }}</small>\n            </div>\n          </div>\n\n          <div class=\"gc-assignment-right\">\n            @if (locked) {\n              <span class=\"gc-badge gc-badge-danger\"><i class=\"fa-solid fa-lock\"></i> Locked</span>\n            } @else if (sub?.status === 'APPROVED') {\n              <span class=\"gc-badge gc-badge-success\"><i class=\"fa-solid fa-circle-check\"></i> Turned in ({{ sub.finalPoints }} pts)</span>\n            } @else if (sub?.status === 'NEEDS_REVISION') {\n              <span class=\"gc-badge gc-badge-danger\"><i class=\"fa-solid fa-triangle-exclamation\"></i> Needs Revision</span>\n            } @else if (sub?.status === 'SUBMITTED') {\n              <span class=\"gc-badge gc-badge-warning\"><i class=\"fa-solid fa-clock\"></i> Turned in</span>\n            } @else {\n              <span class=\"gc-badge gc-badge-info\">Assigned</span>\n            }\n\n            <i class=\"fa-solid\" [class.fa-chevron-down]=\"!isExpanded\" [class.fa-chevron-up]=\"isExpanded\"></i>\n          </div>\n        </div>\n\n        <!-- Expanded Body (Google Classroom Assignment Details & Work Box) -->\n        @if (isExpanded) {\n          <div class=\"gc-assignment-body\">\n            <div class=\"gc-assignment-details-col\">\n              <div class=\"gc-assignment-points\">\n                <span>{{ m.basePoints }} points</span>\n              </div>\n              <p class=\"gc-assignment-instructions\">{{ m.description }}</p>\n\n              <!-- Deliverable Items -->\n              <div class=\"gc-deliverables-section\">\n                <span class=\"gc-deliverables-label\">Required Deliverables:</span>\n                <div class=\"gc-deliverables-chips\">\n                  @for (item of m.deliverablesList; track item.title) {\n                    <div class=\"gc-deliverable-chip\">\n                      <i class=\"fa-solid fa-box\"></i>\n                      <span>{{ item.title }}</span>\n                      <span class=\"gc-badge\" [class.gc-badge-danger]=\"item.isMandatory\" [class.gc-badge-info]=\"!item.isMandatory\">\n                        {{ item.isMandatory ? 'Mandatory' : 'Optional' }}\n                      </span>\n                    </div>\n                  }\n                </div>\n              </div>\n\n              @if (sub && sub.instructorFeedback) {\n                <div class=\"gc-feedback-box\">\n                  <strong>Private Feedback from Teacher:</strong>\n                  <p>{{ sub.instructorFeedback }}</p>\n                </div>\n              }\n            </div>\n\n            <!-- Right Column: \"Your Work\" Box (For Students) / Roster Action (For Faculty) -->\n            <div class=\"gc-assignment-work-col\">\n              @if (authService.currentUser()?.role === 'STUDENT') {\n                <div class=\"gc-card gc-your-work-card\">\n                  <div class=\"gc-your-work-header\">\n                    <h4>Your work</h4>\n                    <span class=\"gc-badge\" [class.gc-badge-success]=\"sub?.status === 'APPROVED'\" [class.gc-badge-warning]=\"sub?.status === 'SUBMITTED'\">\n                      {{ sub?.status || (locked ? 'Locked' : 'Assigned') }}\n                    </span>\n                  </div>\n\n                  @if (locked) {\n                    <p class=\"gc-locked-msg\"><i class=\"fa-solid fa-lock\"></i> Complete Milestone {{ idx }} first to unlock.</p>\n                  } @else if (sub?.status === 'APPROVED') {\n                    <p class=\"gc-approved-msg\"><i class=\"fa-solid fa-circle-check\"></i> Milestone approved & completed!</p>\n                  } @else {\n                    <button class=\"gc-btn gc-btn-primary gc-btn-block\" (click)=\"triggerUpload(m)\">\n                      <i class=\"fa-solid fa-upload\"></i> {{ sub ? 'Resubmit Work' : '+ Add or submit work' }}\n                    </button>\n                  }\n                </div>\n              } @else {\n                <div class=\"gc-card gc-your-work-card\">\n                  <div class=\"gc-your-work-header\">\n                    <h4>Student Submissions</h4>\n                  </div>\n                  <button class=\"gc-btn gc-btn-outline gc-btn-block\" (click)=\"triggerRoster(m)\">\n                    <i class=\"fa-solid fa-users\"></i> View Submissions Roster\n                  </button>\n                </div>\n              }\n            </div>\n          </div>\n        }\n      </div>\n    } @empty {\n      <div class=\"gc-card gc-empty-classwork\">\n        <i class=\"fa-solid fa-file-lines gc-empty-icon\"></i>\n        <h3>This is where you'll see work for this class</h3>\n        <p>No milestones or assignments have been posted yet.</p>\n      </div>\n    }\n  </div>\n</div>\n`, styles: [\"/* src/app/components/class-detail/classwork/classwork.component.css */\\n.gc-classwork-container {\\n  max-width: 900px;\\n  margin: 0 auto;\\n}\\n.gc-classwork-toolbar {\\n  display: flex;\\n  align-items: center;\\n  justify-content: space-between;\\n  margin-bottom: 1.25rem;\\n}\\n.gc-create-btn {\\n  border-radius: var(--gc-radius-pill);\\n  padding: 0.6rem 1.5rem;\\n}\\n.gc-notice-banner {\\n  background: var(--gc-primary-light);\\n  border: 1px solid var(--gc-primary);\\n  border-radius: var(--gc-radius-md);\\n  padding: 0.85rem 1.25rem;\\n  color: var(--gc-primary);\\n  font-size: 0.875rem;\\n  display: flex;\\n  align-items: center;\\n  gap: 0.75rem;\\n  margin