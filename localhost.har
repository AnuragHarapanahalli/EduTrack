c-stream-feed-col\">\n      <div class=\"gc-card gc-announcement-box\">\n        <div class=\"gc-user-avatar-sm\">\n          {{ authService.currentUser()?.fullName?.charAt(0) || 'U' }}\n        </div>\n        <span class=\"gc-announcement-placeholder\">\n          Announce something to your class...\n        </span>\n      </div>\n\n      <div class=\"gc-feed-list\">\n        @for (m of milestones; track m.id) {\n          <div class=\"gc-card gc-feed-item\" (click)=\"goToClasswork()\">\n            <div class=\"gc-feed-icon\">\n              <i class=\"fa-solid fa-file-lines\"></i>\n            </div>\n            <div class=\"gc-feed-content\">\n              <div class=\"gc-feed-title\">\n                <strong>{{ viewStateService.currentSubject()?.instructorName || 'Faculty' }}</strong> posted a new assignment: <span>{{ m.title }}</span>\n              </div>\n              <small class=\"gc-feed-date\">{{ m.deadline | date:'mediumDate' }}</small>\n            </div>\n          </div>\n        } @empty {\n          <div class=\"gc-card gc-empty-feed\">\n            <p>This is where you can talk to your class and see updates.</p>\n          </div>\n        }\n      </div>\n    </div>\n  </div>\n</div>\n`, styles: [\"/* src/app/components/class-detail/stream/stream.component.css */\\n.gc-stream-container {\\n  max-width: 1000px;\\n  margin: 0 auto;\\n}\\n.gc-class-banner {\\n  height: 200px;\\n  border-radius: var(--gc-radius-md);\\n  background:\\n    linear-gradient(\\n      135deg,\\n      #1e88e5 0%,\\n      #1565c0 100%);\\n  color: #ffffff;\\n  padding: 2rem;\\n  display: flex;\\n  flex-direction: column;\\n  justify-content: flex-end;\\n  margin-bottom: 1.5rem;\\n  box-shadow: 0 1px 3px 0 rgba(60, 64, 67, 0.3);\\n}\\n.gc-banner-title {\\n  font-size: 2rem;\\n  font-weight: 500;\\n}\\n.gc-banner-code {\\n  font-size: 1rem;\\n  opacity: 0.9;\\n}\\n.gc-banner-teacher {\\n  font-size: 0.875rem;\\n  opacity: 0.95;\\n  margin-top: 0.5rem;\\n}\\n.gc-stream-grid