# Maven / Java Build Outputs
backend/target/
*.class
*.jar
*.war

# IDE files
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# OS junk
.DS_Store
Thumbs.db

# Log files
*.log

# File uploads (ignore temporary uploaded files, keep folder)
uploads/*
!uploads/.gitkeep

# Project Backups & Large Capture Files
*.zip
*.har

# Node / Angular (Root-level overrides)
**/node_modules/
**/dist/
**/.angular/cache/
**/.sass-cache/
**/tmp/
**/out-tsc/
**/coverage/
**/node/

# Mobile / Gradle / Android / KMP / iOS Build Outputs
.gradle/
**/.gradle/
**/build/
**/.kotlin/
**/local.properties
**/DerivedData/
**/*.xcworkspace/xcuserdata/
**/*.xcodeproj/xcuserdata/
**/*.xcodeproj/project.xcworkspace/xcuserdata/

